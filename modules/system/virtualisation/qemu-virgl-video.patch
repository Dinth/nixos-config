+/*
+ * Hand virglrenderer a render-node fd so it can bring up its VA-API video
+ * backend. virglrenderer takes ownership of the returned fd, so give it a
+ * dup of the display's render node (or open a fresh one) rather than the
+ * shared qemu_egl_rn_fd itself.
+ */
+static int
+virgl_get_drm_fd(G_GNUC_UNUSED void *cookie)
+{
+#ifdef CONFIG_GBM
+    if (qemu_egl_rn_fd >= 0) {
+        return dup(qemu_egl_rn_fd);
+    }
+#endif
+    return qemu_drm_rendernode_open(NULL);
+}
